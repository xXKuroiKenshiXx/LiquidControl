// Panel General: Información, Almacenamiento e Ítems de inicio (subpáginas).

import { Theme, Tints } from "../theme.slint";
import { App, Nav } from "../globals.slint";
import { CompactHeader, IconTile, PaneHeader, Row, Section } from "../widgets/basics.slint";
import { AdminNotice } from "../widgets/notice.slint";
import { TweakList, TweaksState } from "../widgets/tweaks.slint";

export struct DriveView {
    name: string,
    detail: string,
    file-system: string,
    used: string,
    free: string,
    ratio: float,
    removable: bool,
}

export struct StartupView {
    id: string,
    name: string,
    detail: string,
    enabled: bool,
    admin: bool,
    letter: string,
    icon: image,
    has-icon: bool,
    tint: int,
}

export struct RemovedStartupView {
    index: int,
    name: string,
    detail: string,
}

export global GeneralState {
    // Información
    in property <bool> info-loaded;
    in property <string> device-name;
    in property <string> device-model;
    in property <string> cpu;
    in property <string> cores;
    in property <string> memory;
    in property <[string]> gpus;
    in property <string> windows-name;
    in property <string> windows-version;
    in property <string> build;
    in property <string> uptime;
    // Almacenamiento
    in property <[DriveView]> drives;
    // Ítems de inicio
    in property <[StartupView]> startup;
    in property <[RemovedStartupView]> removed;
    in property <string> startup-summary;
    in property <bool> startup-needs-admin;
    callback set-startup(string, bool);
    callback remove-startup(string);
    callback restore-startup(int);
    // Actualizaciones de Windows
    in property <bool> checking-updates;
    callback check-for-updates();
}

component AboutPage {
    VerticalLayout {
        spacing: 22px;
        VerticalLayout {
            spacing: 4px;
            padding-top: 8px;
            HorizontalLayout {
                alignment: center;
                IconTile { icon: @image-url("../icons/monitor.svg"); tint: Tints.blue; size: 76px; }
            }
            Text {
                text: GeneralState.device-name;
                font-size: 21px;
                font-weight: 700;
                color: Theme.label;
                horizontal-alignment: center;
            }
            Text {
                text: GeneralState.device-model;
                font-size: 12px;
                color: Theme.label2;
                horizontal-alignment: center;
            }
        }
        Section {
            Row { first: true; label: @tr("Nombre del dispositivo"); value: GeneralState.device-name; }
            Row { label: @tr("Procesador"); value: GeneralState.cpu; }
            Row { label: @tr("Núcleos"); value: GeneralState.cores; }
            Row { label: @tr("Memoria"); value: GeneralState.memory; }
            for gpu in GeneralState.gpus: Row { label: @tr("Gráficos"); value: gpu; }
        }
        Section {
            title: "Windows";
            Row { first: true; label: @tr("Edición"); value: GeneralState.windows-name; }
            Row { label: @tr("Versión"); value: GeneralState.windows-version; }
            Row { label: @tr("Compilación"); value: GeneralState.build; }
            Row { label: @tr("Tiempo de actividad"); value: GeneralState.uptime; }
        }
        Section {
            Row {
                first: true;
                label: @tr("Especificaciones del dispositivo en Windows");
                clickable: true;
                external: true;
                clicked => { App.open-uri("ms-settings:about"); }
            }
        }
    }
}

component StoragePage {
    VerticalLayout {
        spacing: 22px;
        for drive in GeneralState.drives: Rectangle {
            border-radius: Theme.radius-group;
            background: Theme.group;
            border-width: 1px;
            border-color: Theme.group-border;
            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    IconTile {
                        icon: drive.removable ? @image-url("../icons/usb.svg") : @image-url("../icons/hard-drive.svg");
                        tint: Tints.gray;
                        size: 34px;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: drive.name; font-weight: 600; color: Theme.label; }
                        Text { text: drive.detail; font-size: 11.5px; color: Theme.label2; }
                    }
                    Text {
                        text: drive.file-system;
                        font-size: 11.5px;
                        color: Theme.label2;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 14px;
                    border-radius: 7px;
                    background: Theme.field;
                    Rectangle {
                        x: 0;
                        width: max(8px, parent.width * drive.ratio);
                        border-radius: 7px;
                        background: drive.ratio > 0.9
                            ? @linear-gradient(90deg, #ff453a 0%, #ff9f0a 100%)
                            : @linear-gradient(90deg, Theme.accent 0%, Theme.accent.with-alpha(0.7) 100%);
                        animate width { duration: Theme.bouncy; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
                    }
                }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: drive.ratio > 0.9 ? Theme.danger : Theme.accent; }
                        }
                        Text { text: drive.used; font-size: 11.5px; color: Theme.label2; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.label3; }
                        }
                        Text { text: drive.free; font-size: 11.5px; color: Theme.label2; }
                    }
                }
            }
        }
        Section {
            Row {
                first: true;
                label: @tr("Sensor de almacenamiento");
                sub: @tr("Liberá espacio automáticamente borrando archivos temporales y vaciando la papelera.");
                clickable: true;
                external: true;
                clicked => { App.open-uri("ms-settings:storagesense"); }
            }
            Row {
                label: @tr("Recomendaciones de limpieza");
                clickable: true;
                external: true;
                clicked => { App.open-uri("ms-settings:storagerecommendations"); }
            }
        }
    }
}

component StartupPage {
    VerticalLayout {
        spacing: 22px;
        CompactHeader {
            icon: @image-url("../icons/list-checks.svg");
            tint: Tints.gray;
            title: @tr("Ítems de inicio");
            description: @tr("Estas apps se abren solas al iniciar sesión. Desactivá las que no usás o quitalas de la lista para que el arranque sea más rápido.");
        }
        Section {
            title: @tr("Abrir al iniciar sesión");
            footer: GeneralState.startup-summary;
            for item[i] in GeneralState.startup: Row {
                first: i == 0;
                leading-app: true;
                app-icon: item.icon;
                app-icon-set: item.has-icon;
                app-letter: item.letter;
                tint: Tints.palette[Math.mod(item.tint, Tints.palette.length)];
                label: item.name;
                sub: item.detail;
                button2: @tr("Quitar");
                button2-destructive: true;
                toggle: true;
                checked: item.enabled;
                toggle-enabled: !item.admin || App.admin;
                toggled(value) => { GeneralState.set-startup(item.id, value); }
                button2-clicked => { GeneralState.remove-startup(item.id); }
            }
            if GeneralState.startup.length == 0: Row { first: true; label: @tr("No hay ítems de inicio."); }
        }
        if GeneralState.removed.length > 0: Section {
            title: @tr("Quitados recientemente");
            footer: @tr("LiquidControl guarda una copia de cada ítem quitado para que puedas volver a agregarlo.");
            for item[i] in GeneralState.removed: Row {
                first: i == 0;
                label: item.name;
                sub: item.detail;
                button: @tr("Restaurar");
                button-clicked => { GeneralState.restore-startup(item.index); }
            }
        }
        if GeneralState.startup-needs-admin && !App.admin: AdminNotice {
            text: @tr("Los ítems de todos los usuarios solo se pueden cambiar como administrador.");
        }
    }
}

component UpdatesPage {
    VerticalLayout {
        spacing: 22px;
        CompactHeader {
            icon: @image-url("../icons/refresh-cw.svg");
            tint: Tints.blue;
            title: @tr("Actualizaciones de Windows");
            description: @tr("Buscá actualizaciones ahora y elegí qué tan seguido y agresivo es Windows Update con tu PC.");
        }
        Section {
            Row {
                first: true;
                has-icon: true;
                icon: @image-url("../icons/refresh-cw.svg");
                tint: Tints.blue;
                label: @tr("Buscar actualizaciones ahora");
                sub: @tr("Le pide a Windows que busque actualizaciones ya mismo (la descarga y el progreso se ven en Configuración).");
                button: @tr("Buscar");
                button-busy: GeneralState.checking-updates;
                button-clicked => { GeneralState.check-for-updates(); }
            }
            Row {
                label: @tr("Abrir Windows Update");
                clickable: true;
                external: true;
                clicked => { App.open-uri("ms-settings:windowsupdate"); }
            }
        }
        TweakList { category: TweaksState.updates; }
    }
}

export component GeneralPane {
    VerticalLayout {
        spacing: 22px;
        if Nav.sub == "about": AboutPage { }
        if Nav.sub == "storage": StoragePage { }
        if Nav.sub == "startup": StartupPage { }
        if Nav.sub == "updates": UpdatesPage { }
        if Nav.sub == "": VerticalLayout {
            spacing: 22px;
            PaneHeader {
                icon: @image-url("../icons/settings.svg");
                tint: Tints.gray;
                title: @tr("General");
                description: @tr("Administrá la configuración general de tu PC: información del sistema, almacenamiento, programas de inicio y más.");
            }
            Section {
                Row {
                    first: true;
                    has-icon: true;
                    icon: @image-url("../icons/refresh-cw.svg");
                    tint: Tints.blue;
                    label: @tr("Actualizaciones de Windows");
                    sub: @tr("Buscar ahora y ajustar cómo actualiza tu PC.");
                    clickable: true;
                    highlighted: Nav.highlight == "updates";
                    clicked => { Nav.open("general", "updates", ""); }
                }
                Row {
                    has-icon: true;
                    icon: @image-url("../icons/info.svg");
                    label: @tr("Información");
                    clickable: true;
                    highlighted: Nav.highlight == "about";
                    clicked => { Nav.open("general", "about", ""); }
                }
                Row {
                    has-icon: true;
                    icon: @image-url("../icons/hard-drive.svg");
                    label: @tr("Almacenamiento");
                    clickable: true;
                    highlighted: Nav.highlight == "storage";
                    clicked => { Nav.open("general", "storage", ""); }
                }
            }
            Section {
                Row {
                    first: true;
                    has-icon: true;
                    icon: @image-url("../icons/list-checks.svg");
                    label: @tr("Ítems de inicio");
                    clickable: true;
                    highlighted: Nav.highlight == "startup";
                    clicked => { Nav.open("general", "startup", ""); }
                }
                Row {
                    has-icon: true;
                    icon: @image-url("../icons/globe.svg");
                    tint: Tints.blue;
                    label: @tr("Idioma y región");
                    clickable: true;
                    external: true;
                    clicked => { App.open-uri("ms-settings:regionlanguage"); }
                }
                Row {
                    has-icon: true;
                    icon: @image-url("../icons/clock.svg");
                    tint: Tints.blue;
                    label: @tr("Fecha y hora");
                    clickable: true;
                    external: true;
                    clicked => { App.open-uri("ms-settings:dateandtime"); }
                }
            }
            Section {
                Row {
                    first: true;
                    has-icon: true;
                    icon: @image-url("../icons/rotate-ccw.svg");
                    label: @tr("Recuperación y restablecimiento");
                    clickable: true;
                    external: true;
                    clicked => { App.open-uri("ms-settings:recovery"); }
                }
            }
        }
    }
}
