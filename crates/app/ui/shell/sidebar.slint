// Barra lateral flotante: semáforo, búsqueda, tarjeta de la cuenta y paneles por grupos.

import { Theme } from "../theme.slint";
import { App, Nav, PaneInfo, Registry, SearchResult } from "../globals.slint";
import { IconTile } from "../widgets/basics.slint";
import { SearchField } from "../widgets/controls.slint";
import { ScrollArea } from "../widgets/scroll-area.slint";
import { TrafficLights } from "window-controls.slint";

// Nota: un drop-shadow con blur 0 no desaparece, dibuja una copia sólida sin
// difuminar de la forma en el color de sombra (blur 0 ≠ sin sombra). Por eso
// el color también tiene que ser condicional, no solo el blur. Y va en un
// hijo, no en la raíz: si no, Slint copia este componente entero en cada fila.
component SidebarItem {
    in property <PaneInfo> pane;
    in property <string> context;
    in property <bool> selected;
    callback clicked();

    height: root.context != "" ? 38px : 30px;

    Rectangle {
        border-radius: 9px;
        // Seleccionado: cápsula de acento con reflejo de vidrio y un leve resplandor.
        background: root.selected
            ? (Theme.accent-glass ? Theme.accent-brush
                : @linear-gradient(180deg, Theme.accent.brighter(0.12 * Theme.glass) 0%, Theme.accent 100%))
            : touch.has-hover ? Theme.hover : transparent;
        drop-shadow-blur: root.selected ? 6px * Theme.glass : 0px;
        drop-shadow-color: root.selected ? Theme.accent.with-alpha(0.45) : transparent;
        drop-shadow-offset-y: root.selected ? 1px : 0px;
        transform-scale-x: touch.pressed ? 1 - Theme.squish : 1;
        transform-scale-y: touch.pressed ? 1 - Theme.squish : 1;
        animate transform-scale-x, transform-scale-y { duration: Theme.quick; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        accessible-role: button;
        accessible-label: root.pane.title;
        accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            IconTile { icon: root.pane.icon; tint: root.pane.tint; size: 20px; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.pane.title;
                font-size: 13px;
                color: root.selected ? Theme.on-accent : Theme.label;
                overflow: elide;
            }
            if root.context != "": Text {
                text: root.context;
                font-size: 10.5px;
                color: root.selected ? Theme.on-accent.with-alpha(0.75) : Theme.label2;
                overflow: elide;
            }
        }
    }
        touch := TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

component Group {
    in property <[PaneInfo]> panes;
    VerticalLayout {
        spacing: 1px;
        for pane in root.panes: SidebarItem {
            pane: pane;
            selected: Nav.pane == pane.id;
            clicked => { Nav.open(pane.id, "", ""); }
        }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <string> query;

    width: Theme.sidebar-width;
    border-radius: 20px;
    background: Theme.sidebar;
    border-width: 1px;
    border-color: Theme.glass > 0.05 ? Theme.glass-rim.with-alpha(Theme.dark ? 0.1 + 0.12 * Theme.glass : 0.5 + 0.3 * Theme.glass) : Theme.sidebar-border;
    drop-shadow-blur: 14px + 14px * Theme.glass;
    drop-shadow-color: Theme.shadow;
    drop-shadow-offset-y: 3px + 4px * Theme.glass;

    clip: true;

    // Liquid Glass: reflejo que cae desde arriba, un brillo concentrado como el
    // de una fuente de luz (lo que de verdad lee como "vidrio" y no transparencia
    // plana) y una línea especular fina en el borde superior.
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height * 0.45;
        border-top-left-radius: 19px;
        border-top-right-radius: 19px;
        background: @linear-gradient(180deg, Theme.glass-sheen 0%, rgba(255, 255, 255, 0) 100%);
    }
    Rectangle {
        x: -40px;
        y: -50px;
        width: 200px;
        height: 200px;
        background: @radial-gradient(circle, rgba(255, 255, 255, min(0.5, 0.4 * Theme.glass)) 0%, rgba(255, 255, 255, 0) 65%);
    }
    Rectangle {
        x: 18px;
        y: 1px;
        width: parent.width - 36px;
        height: 1px;
        background: Theme.glass-shine;
    }
    // Sombra que se junta al pie: le da profundidad al vidrio en vez de dejarlo
    // como una lámina de un solo tono.
    Rectangle {
        x: 1px;
        y: parent.height - self.height - 1px;
        width: parent.width - 2px;
        height: parent.height * 0.35;
        border-bottom-left-radius: 19px;
        border-bottom-right-radius: 19px;
        background: @linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, Theme.glass-shadow-inner 100%);
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 8px;
        spacing: 8px;

        // Zona de arrastre de la ventana con el semáforo.
        Rectangle {
            height: 40px;
            TouchArea {
                // Se arrastra recién cuando el puntero se mueve: así el doble clic sigue funcionando.
                moved => { if self.pressed { App.window-drag(); } }
                double-clicked => { App.window-maximize(); }
            }
            if App.mac-controls: TrafficLights {
                x: 8px;
                y: 16px;
                inactive: !App.window-active;
            }
        }

        SearchField {
            text <=> root.query;
            edited(text) => { App.search-changed(text); }
            accepted => {
                if App.search-results.length > 0 {
                    Nav.open(App.search-results[0].pane, "", App.search-results[0].item);
                }
            }
        }

        ScrollArea {
            vertical-stretch: 1;
            spacing: 12px;
            inset-top: 2px;

            if root.query == "": Rectangle {
                    height: 50px;
                    border-radius: 12px;
                    background: Nav.pane == "account" ? Theme.accent-brush : account-touch.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 18px;
                                clip: true;
                                background: @linear-gradient(180deg, #b4b4ba 0%, #86868d 100%);
                                if App.has-avatar: Image {
                                    source: App.avatar;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                }
                                if !App.has-avatar: Text {
                                    text: App.initials;
                                    color: #ffffff;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: App.user-name;
                                font-weight: 600;
                                color: Nav.pane == "account" ? Theme.on-accent : Theme.label;
                                overflow: elide;
                            }
                            Text {
                                text: App.account-kind;
                                font-size: 11px;
                                color: Nav.pane == "account" ? Theme.on-accent.with-alpha(0.75) : Theme.label2;
                            }
                        }
                    }
                    account-touch := TouchArea {
                        clicked => { Nav.open("account", "", ""); }
                    }
                }
                if root.query == "": Group { panes: Registry.group1; }
                if root.query == "": Group { panes: Registry.group2; }
                if root.query == "": Group { panes: Registry.group3; }
                if root.query == "": Group { panes: Registry.group4; }
                if root.query == "": Group { panes: Registry.group5; }
                if root.query == "": Group { panes: Registry.group6; }
                if root.query == "": Group { panes: Registry.group7; }

                if root.query != "" && App.search-results.length == 0: Text {
                    text: @tr("Sin resultados");
                    color: Theme.label2;
                    horizontal-alignment: center;
                }
                if root.query != "": VerticalLayout {
                    spacing: 1px;
                    for result[i] in App.search-results: SidebarItem {
                        pane: { id: result.pane, title: result.title, icon: result.icon, tint: result.tint };
                        context: result.context;
                        selected: i == 0;
                        clicked => { Nav.open(result.pane, "", result.item); }
                    }
                }
        }
    }
}

