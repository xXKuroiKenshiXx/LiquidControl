// Capas superpuestas: diálogo modal y avisos flotantes, de vidrio y con
// animación de entrada (su intensidad sigue a Theme.motion).

import { Theme } from "../theme.slint";
import { Dialog, Toasts, ToastView } from "../globals.slint";
import { Button } from "../widgets/basics.slint";

export component DialogOverlay inherits Rectangle {
    // Se crea al abrir el diálogo: arranca oculto y aparece en el siguiente cuadro.
    property <bool> shown: false;
    property <float> reveal: root.shown ? 1 : 0;
    animate reveal { duration: Theme.smooth; easing: cubic-bezier(0.32, 0.72, 0, 1); }
    background: rgba(0, 0, 0, 0.26 * root.reveal);
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }
    // Bloquea los clics al resto de la ventana.
    TouchArea { }

    card := Rectangle {
        width: min(400px, root.width - 40px);
        height: layout.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        opacity: root.reveal;
        transform-scale-x: 1 - 0.08 * min(1.5, Theme.motion) * (1 - root.reveal);
        transform-scale-y: 1 - 0.08 * min(1.5, Theme.motion) * (1 - root.reveal);
        border-radius: 18px;
        background: @linear-gradient(180deg, Theme.sheet-top 0%, Theme.sheet-bottom 100%);
        border-width: 1px;
        border-color: Theme.dark ? Theme.glass-rim : Theme.group-border;
        drop-shadow-blur: 24px + 16px * Theme.glass;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 12px;

        layout := VerticalLayout {
            padding: 20px;
            spacing: 10px;
            Text {
                text: Dialog.title;
                font-size: 14px;
                font-weight: 650;
                color: Theme.label;
                wrap: word-wrap;
            }
            if Dialog.message != "": Text {
                text: Dialog.message;
                font-size: 12.5px;
                color: Theme.label;
                wrap: word-wrap;
            }
            if Dialog.has-input: Rectangle {
                height: 30px;
                border-radius: 8px;
                background: Theme.field;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent.with-alpha(0.55) : Theme.group-border;
                if Dialog.input == "": Text {
                    x: 10px;
                    text: Dialog.placeholder;
                    color: Theme.label2;
                    vertical-alignment: center;
                    height: 100%;
                }
                input := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    height: 100%;
                    text <=> Dialog.input;
                    color: Theme.label;
                    input-type: Dialog.secret ? InputType.password : InputType.text;
                    single-line: true;
                    vertical-alignment: center;
                    init => { self.focus(); }
                    accepted => { Dialog.confirmed(Dialog.tag, Dialog.input); }
                }
            }
            if Dialog.error != "": Text {
                text: Dialog.error;
                font-size: 12px;
                color: Theme.danger;
                wrap: word-wrap;
            }
            HorizontalLayout {
                padding-top: 8px;
                spacing: 8px;
                alignment: end;
                if Dialog.cancel-text != "": Button {
                    text: Dialog.cancel-text;
                    enabled: !Dialog.busy;
                    clicked => { Dialog.cancelled(Dialog.tag); }
                }
                Button {
                    text: Dialog.confirm-text;
                    primary: !Dialog.destructive;
                    destructive: Dialog.destructive;
                    busy: Dialog.busy;
                    enabled: !Dialog.has-input || Dialog.input.character-count >= max(1, Dialog.min-input);
                    clicked => { Dialog.confirmed(Dialog.tag, Dialog.input); }
                }
            }
        }
    }
}

// Aviso flotante: cápsula de vidrio que entra con un rebote.
component ToastPill inherits Rectangle {
    in property <ToastView> toast;
    property <bool> shown: false;
    property <float> reveal: root.shown ? 1 : 0;
    animate reveal { duration: Theme.bouncy; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }

    height: 38px;
    opacity: min(1, root.reveal);
    transform-scale-x: 0.85 + 0.15 * root.reveal;
    transform-scale-y: 0.85 + 0.15 * root.reveal;
    border-radius: 19px;
    background: @linear-gradient(180deg, Theme.sheet-top 0%, Theme.sheet-bottom 100%);
    border-width: 1px;
    border-color: Theme.dark ? Theme.glass-rim : Theme.group-border;
    drop-shadow-blur: Theme.glass-blur;
    drop-shadow-color: Theme.shadow;
    drop-shadow-offset-y: 6px;
    HorizontalLayout {
        padding-left: 13px;
        padding-right: root.toast.action != "" ? 7px : 16px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.toast.kind == 2 ? @image-url("../icons/circle-alert.svg")
                    : root.toast.kind == 1 ? @image-url("../icons/circle-check.svg")
                    : @image-url("../icons/info.svg");
                width: 15px;
                height: 15px;
                colorize: root.toast.kind == 2 ? Theme.danger : root.toast.kind == 1 ? Theme.success : Theme.accent;
            }
        }
        Text {
            text: root.toast.message;
            font-size: 12.5px;
            color: Theme.label;
            vertical-alignment: center;
            max-width: 460px;
            overflow: elide;
        }
        if root.toast.action != "": VerticalLayout {
            alignment: center;
            Button {
                text: root.toast.action;
                primary: true;
                small: true;
                clicked => { Toasts.action(root.toast.id); }
            }
        }
    }
}

export component ToastStack {
    VerticalLayout {
        alignment: end;
        spacing: 8px;
        for toast in Toasts.items: HorizontalLayout {
            alignment: center;
            ToastPill { toast: toast; }
        }
    }
}
