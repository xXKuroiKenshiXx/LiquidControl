// Controles de entrada estilo macOS: segmentado, deslizador, menú emergente,
// campo de búsqueda, casilla, insignias, avatares e indicador de Wi‑Fi.

import { Theme, Tint, Tints } from "../theme.slint";

// Control segmentado con indicador que se desliza entre opciones.
export component Segmented {
    in property <[string]> labels;
    in property <int> selected;
    in property <bool> enabled: true;
    callback activated(int);

    property <length> cell: self.width / max(1, root.labels.length);
    height: 26px;
    min-width: root.labels.length * 80px;
    accessible-role: tab-list;

    // La opacidad va en un hijo: en la raíz, Slint copiaría el control en cada uso.
    Rectangle {
        opacity: root.enabled ? 1 : 0.45;
        Rectangle {
            border-radius: self.height / 2;
            background: Theme.field;
            border-width: 1px;
            border-color: Theme.group-border;
        }
        Rectangle {
            x: 2px + root.selected * root.cell;
            y: 2px;
            width: root.cell - 4px;
            height: root.height - 4px;
            border-radius: self.height / 2;
            background: Theme.dark ? #ffffff38 : #ffffff;
            drop-shadow-blur: 2px;
            drop-shadow-color: #00000033;
            drop-shadow-offset-y: 0.5px;
            animate x { duration: Theme.smooth; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
        }
        for label[i] in root.labels: Rectangle {
            x: i * root.cell;
            width: root.cell;
            height: root.height;
            accessible-role: tab;
            accessible-label: label;
            Text {
                text: label;
                font-size: 12px;
                font-weight: i == root.selected ? 600 : 400;
                color: i == root.selected ? Theme.label : Theme.label2;
                overflow: elide;
            }
            TouchArea {
                enabled: root.enabled;
                clicked => { root.activated(i); }
            }
        }
    }
}

// Deslizador estilo Tahoe: riel fino con relleno de acento y perilla cápsula.
// `moved` avisa mientras se arrastra; `released`, al soltar.
export component Slider {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <int> ticks: 0;
    in property <string> min-label;
    in property <string> max-label;
    in property <bool> enabled: true;
    in property <string> label;
    callback moved(float);
    callback released(float);

    property <bool> dragging: false;
    property <float> drag-value: 0;
    property <float> shown: self.dragging ? self.drag-value : root.value;
    property <float> ratio: root.maximum > root.minimum ? clamp((self.shown - root.minimum) / (root.maximum - root.minimum), 0, 1) : 0;

    min-width: 200px;
    height: root.ticks > 1 ? 30px : 22px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: round(root.value);
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    forward-focus: focus;

    pure function snap(v: float) -> float {
        return clamp(round((v - root.minimum) / root.step) * root.step + root.minimum, root.minimum, root.maximum);
    }

    // La opacidad va en un hijo: en la raíz, Slint copiaría el control en cada uso.
    Rectangle {
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        spacing: 10px;
        if root.min-label != "": Text {
            text: root.min-label;
            font-size: 11px;
            color: Theme.label2;
            vertical-alignment: center;
        }
        area := Rectangle {
            horizontal-stretch: 1;
            property <length> knob-w: 26px;
            // Riel
            Rectangle {
                y: 8px;
                height: 6px;
                border-radius: 3px;
                background: Theme.track;
                Rectangle {
                    x: 0;
                    width: max(6px, root.ratio * (parent.width - area.knob-w) + area.knob-w / 2);
                    border-radius: 3px;
                    background: Theme.accent-brush;
                }
            }
            // Marcas
            if root.ticks > 1: HorizontalLayout {
                y: 22px;
                height: 5px;
                padding-left: area.knob-w / 2 - 0.5px;
                padding-right: area.knob-w / 2 - 0.5px;
                alignment: space-between;
                for i in root.ticks: Rectangle { width: 1px; background: Theme.label3; }
            }
            // Perilla (se vuelve una lente de vidrio al arrastrar)
            Rectangle {
                x: root.ratio * (parent.width - area.knob-w) - (root.dragging ? 4px : 0px);
                y: 11px - self.height / 2;
                width: area.knob-w + (root.dragging ? 8px : 0px);
                height: root.dragging ? 24px : 18px;
                border-radius: self.height / 2;
                background: root.dragging ? #ffffff45 : #ffffff;
                border-width: root.dragging ? 1px : 0px;
                border-color: #ffffffe6;
                drop-shadow-blur: root.dragging ? 8px : 3px;
                drop-shadow-color: #00000052;
                drop-shadow-offset-y: 1px;
                animate width, height, background, drop-shadow-blur { duration: Theme.quick; }
            }
            touch := TouchArea {
                enabled: root.enabled;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.dragging = true;
                        root.drag-value = root.snap(root.minimum + clamp((self.mouse-x - area.knob-w / 2) / (self.width - area.knob-w), 0, 1) * (root.maximum - root.minimum));
                        root.moved(root.drag-value);
                    } else if event.kind == PointerEventKind.up && root.dragging {
                        root.dragging = false;
                        root.released(root.drag-value);
                    }
                }
                moved => {
                    if root.dragging {
                        root.drag-value = root.snap(root.minimum + clamp((self.mouse-x - area.knob-w / 2) / (self.width - area.knob-w), 0, 1) * (root.maximum - root.minimum));
                        root.moved(root.drag-value);
                    }
                }
            }
        }
        if root.max-label != "": Text {
            text: root.max-label;
            font-size: 11px;
            color: Theme.label2;
            vertical-alignment: center;
        }
    }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.released(root.snap(root.value + root.step));
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.released(root.snap(root.value - root.step));
                return accept;
            }
            return reject;
        }
    }
}

// Botón emergente de macOS: muestra el valor y abre un menú con marca de selección.
export component PopupButton {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    in property <string> label;
    callback activated(int);

    height: 24px;
    min-width: 120px;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";

    // La opacidad va en un hijo: en la raíz, Slint copiaría el control en cada uso.
    Rectangle {
        opacity: root.enabled ? 1 : 0.45;
        Rectangle {
            border-radius: self.height / 2;
            background: Theme.control;
            border-width: 1px;
            border-color: Theme.control-border;
            drop-shadow-blur: 1.5px;
            drop-shadow-color: #0000002e;
            drop-shadow-offset-y: 0.5px;
        }
        HorizontalLayout {
            padding-left: 11px;
            padding-right: 8px;
            spacing: 8px;
            Text {
                text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "—";
                color: Theme.label;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../icons/chevrons-up-down.svg");
                    width: 12px;
                    height: 12px;
                    colorize: Theme.label2;
                }
            }
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: -6px;
        y: -5px - max(0, root.selected) * 26px;
        width: max(root.width + 12px, 170px);
        Rectangle {
            border-radius: 11px;
            background: Theme.dark ? #3a3a3ef5 : #fafafcf5;
            border-width: 1px;
            border-color: Theme.group-border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 8px;
        }
        VerticalLayout {
            padding: 5px;
            for option[i] in root.options: Rectangle {
                height: 26px;
                border-radius: 6px;
                background: item.has-hover ? Theme.accent-brush : transparent;
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 12px;
                    spacing: 3px;
                    Rectangle {
                        width: 16px;
                        if i == root.selected: Image {
                            source: @image-url("../icons/check.svg");
                            width: 12px;
                            height: 12px;
                            colorize: item.has-hover ? Theme.on-accent : Theme.label;
                        }
                    }
                    Text {
                        text: option;
                        font-size: 13px;
                        color: item.has-hover ? Theme.on-accent : Theme.label;
                        vertical-alignment: center;
                    }
                }
                item := TouchArea {
                    clicked => { root.activated(i); }
                }
            }
        }
    }
}

// Campo de búsqueda cápsula con lupa y botón para borrar.
export component SearchField {
    in-out property <string> text;
    in property <string> placeholder: @tr("Buscar");
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);

    height: 28px;
    forward-focus: input;
    accessible-role: text-input;
    accessible-label: root.placeholder;

    Rectangle {
        border-radius: self.height / 2;
        background: Theme.field;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent.with-alpha(0.55) : Theme.group-border;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 7px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../icons/search.svg");
                width: 13px;
                height: 13px;
                colorize: Theme.label2;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                text: root.placeholder;
                color: Theme.label2;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            input := TextInput {
                text <=> root.text;
                color: Theme.label;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.accent.with-alpha(0.35);
                enabled: root.enabled;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }
        if root.text != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 15px;
                height: 15px;
                border-radius: 7.5px;
                background: Theme.label3;
                Image {
                    source: @image-url("../icons/x.svg");
                    width: 9px;
                    height: 9px;
                    colorize: Theme.content;
                }
                TouchArea {
                    clicked => {
                        root.text = "";
                        root.edited("");
                    }
                }
            }
        }
    }
}

// Casilla de verificación estilo macOS.
export component Checkbox {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);

    width: 16px;
    height: 16px;
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.label;

    Rectangle {
        border-radius: 4.5px;
        background: root.checked ? Theme.accent-brush : Theme.control;
        border-width: root.checked ? 0px : 1px;
        border-color: Theme.control-border;
    }
    if root.checked: Image {
        source: @image-url("../icons/check.svg");
        width: 11px;
        height: 11px;
        colorize: Theme.on-accent;
    }
    TouchArea {
        clicked => { root.toggled(!root.checked); }
    }
}

// Insignia de texto (riesgo, estado parcial…).
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.warning;
    height: 18px;
    border-radius: 9px;
    background: root.tone.with-alpha(0.16);
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.text;
            color: root.tone;
            font-size: 10.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Ícono genérico para apps sin ícono: inicial sobre un color.
export component LetterAvatar inherits Rectangle {
    in property <string> letter;
    in property <Tint> tint: Tints.blue;
    in property <length> size: 22px;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.26;
    background: @linear-gradient(180deg, root.tint.top 0%, root.tint.bottom 100%);
    Text {
        text: root.letter;
        color: #ffffff;
        font-size: root.size * 0.5;
        font-weight: 650;
    }
}

// Ícono de Wi‑Fi con barras de intensidad (nivel 0–3).
export component WifiGlyph {
    in property <int> level: 3;
    in property <color> color: Theme.label;
    in property <color> dim: Theme.label3;
    width: 16px;
    height: 16px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M2.4 9a14.2 14.2 0 0 1 19.2 0";
        stroke: root.level >= 3 ? root.color : root.dim;
        stroke-width: 1.8px;
        fill: transparent;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M5.6 12.7a9.6 9.6 0 0 1 12.8 0";
        stroke: root.level >= 2 ? root.color : root.dim;
        stroke-width: 1.8px;
        fill: transparent;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M8.9 16.3a4.9 4.9 0 0 1 6.2 0";
        stroke: root.level >= 1 ? root.color : root.dim;
        stroke-width: 1.8px;
        fill: transparent;
    }
    Rectangle {
        x: parent.width / 2 - 1.2px;
        y: parent.height * 0.78;
        width: 2.4px;
        height: 2.4px;
        border-radius: 1.2px;
        background: root.color;
    }
}
