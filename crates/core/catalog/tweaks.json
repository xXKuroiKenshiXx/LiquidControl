{
  "version": 1,
  "tweaks": [
    {
      "id": "privacy.telemetry",
      "category": "privacy",
      "section": "Telemetría y diagnóstico",
      "title": "Limitar la telemetría de Windows",
      "description": "Reduce los datos de diagnóstico que Windows envía a Microsoft al mínimo que permite tu edición.",
      "risk": "safe",
      "restart": "none",
      "icon": "eye-off",
      "ops": [
        { "reg": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "type": "dword", "on": 0, "off": null },
        { "reg": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\DataCollection", "name": "AllowTelemetry", "type": "dword", "on": 0, "off": null }
      ]
    },
    {
      "id": "privacy.telemetry_service",
      "category": "privacy",
      "section": "Telemetría y diagnóstico",
      "title": "Desactivar el servicio de telemetría",
      "description": "Detiene «Experiencias del usuario y telemetría asociadas» (DiagTrack), el servicio que recopila y envía los datos.",
      "risk": "moderate",
      "restart": "none",
      "ops": [
        { "service": "DiagTrack", "on": "disabled", "off": "auto" },
        { "service": "dmwappushservice", "on": "disabled", "off": "manual" }
      ]
    },
    {
      "id": "privacy.telemetry_tasks",
      "category": "privacy",
      "section": "Telemetría y diagnóstico",
      "title": "Desactivar tareas programadas de recopilación",
      "description": "Programa de mejora de la experiencia del usuario, evaluador de compatibilidad y encuestas de comentarios.",
      "risk": "safe",
      "restart": "none",
      "ops": [
        { "task": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\Consolidator", "on": "disabled" },
        { "task": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\UsbCeip", "on": "disabled" },
        { "task": "\\Microsoft\\Windows\\Application Experience\\Microsoft Compatibility Appraiser", "on": "disabled" },
        { "task": "\\Microsoft\\Windows\\Feedback\\Siuf\\DmClient", "on": "disabled" },
        { "task": "\\Microsoft\\Windows\\Feedback\\Siuf\\DmClientOnScenarioDownload", "on": "disabled" }
      ]
    },
    {
